# ============ DATABASE ============
DATABASE_URL="postgresql://meuagito:meuagito123@localhost:5432/meu_agito_db?schema=public"

# ============ SERVER ============
PORT=3001
NODE_ENV=development

# ============ CORS ============
CORS_ORIGIN="http://localhost:3000"

# ============ JWT ============
JWT_SECRET="sua_chave_secreta_super_segura_aqui_123456789"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="sua_chave_refresh_super_segura_aqui_987654321"
REFRESH_TOKEN_EXPIRATION="7d"

# ============ REDIS ============
REDIS_URL="redis://redis:6379"
REDIS_HOST="redis"
REDIS_PORT=6379

# ============ CACHE ============
CACHE_TTL_HOT=60 # 1 minuto
CACHE_TTL_WARM=1800 # 30 minutos
CACHE_TTL_COLD=86400 # 24 horas

# ============ EXTERNAL APIs ============
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# ============ LOGGING ============
LOG_LEVEL="debug"

# ============ EMAIL ============
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# ============ AWS ============
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET="meuagito-uploads"

# ============ FEATURES ============
ENABLE_SWAGGER=true
ENABLE_LOGGING=true
