# ============ DATABASE ============
DATABASE_URL="postgresql://username:password@localhost:5432/meu_agito_db?schema=public"

# ============ SERVER ============
PORT=3001
NODE_ENV=development

# ============ CORS ============
CORS_ORIGIN="http://localhost:3000,http://localhost:19000"

# ============ JWT ============
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-key-change-this-in-production"
REFRESH_TOKEN_EXPIRATION="7d"

# ============ REDIS ============
REDIS_URL="redis://redis:6379"
REDIS_HOST="redis"
REDIS_PORT=6379

# ============ CACHE ============
CACHE_TTL_HOT=60
CACHE_TTL_WARM=1800
CACHE_TTL_COLD=86400

# ============ EXTERNAL APIs ============
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# ============ AWS (OPTIONAL) ============
# AWS_ACCESS_KEY_ID="your-aws-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# ============ EMAIL (OPTIONAL) ============
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
