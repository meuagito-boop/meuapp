# ============ DATABASE ============
DATABASE_URL="postgresql://meuagito:meuagito123@localhost:5434/meu_agito_db?schema=public"

# ============ SERVER ============
PORT=3001
NODE_ENV=development
TRUST_PROXY=false
ENABLE_SWAGGER=true
SUPPORT_EMAIL="support@meuagito.com"

# ============ CORS ============
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,http://localhost:19006"
# In staging/prod, use the mobile deep link base when e-mail links should open the app: meuagito://
FRONTEND_URL="http://localhost:8081,http://localhost:19006"

# ============ RATE LIMIT ============
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
RATE_LIMIT_BLOCK_MS=60000

# ============ JWT ============
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-key-change-this-in-production"
REFRESH_TOKEN_EXPIRATION="7d"

# ============ REDIS ============
ENABLE_REDIS=true
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# ============ CACHE ============
CACHE_TTL_HOT=60
CACHE_TTL_WARM=1800
CACHE_TTL_COLD=86400

# ============ EXTERNAL APIs ============
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# ============ STORAGE (S3 / CloudFront) ============
STORAGE_PROVIDER="none" # none | s3
LOCAL_STORAGE_ROOT="storage"
BACKEND_PUBLIC_URL="http://localhost:3001"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS aliases also accepted by env validator:
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional (S3-compatible endpoint)
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE=false
# CloudFront optional (enable only when distribution exists)
USE_CLOUDFRONT=false
CLOUDFRONT_BASE_URL=""
AWS_CLOUDFRONT_URL=""

# ============ EMAIL ============
ENABLE_EMAIL=false
EMAIL_PROVIDER="none" # none | ses
# SES vars (required when EMAIL_PROVIDER=ses)
AWS_SES_REGION=""
AWS_SES_FROM_EMAIL=""

# ============ PUSH ============
PUSH_PROVIDER="none" # none | sns
AWS_SNS_REGION=""
AWS_SNS_DEFAULT_TOPIC_ARN=""
AWS_SNS_TOPIC_ARN_PREFIX=""
AWS_SNS_PLATFORM_APPLICATION_ARN=""
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=""
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=""

# ============ OBSERVABILITY ============
APP_NAME="meu-agito-backend"
LOG_LEVEL="info"
HEALTHCHECK_VERIFY_STORAGE=false
AWS_CLOUDWATCH_LOG_GROUP="/aws/ecs/meuagito-prod-backend"
AWS_CLOUDWATCH_LOG_RETENTION_DAYS=30
AWS_CLOUDWATCH_NAMESPACE="MeuAgito/prod"
AWS_XRAY_ENABLED=false
AWS_XRAY_DAEMON_ADDRESS="127.0.0.1:2000"
AWS_XRAY_CONTEXT_MISSING="LOG_ERROR"
AWS_XRAY_SERVICE_NAME="meu-agito-backend"
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0
