# ============ TEST DATABASE ============
# Use PostgreSQL em container (docker-compose) para testes
DATABASE_URL="postgresql://test_user:test_password@localhost:5433/meu_agito_test?schema=public"

# ============ TEST SERVER ============
PORT=3002
NODE_ENV=test
TRUST_PROXY=false
ENABLE_SWAGGER=false

# ============ CORS (Test) ============
CORS_ORIGIN="http://localhost:3002"

# ============ RATE LIMIT (Test) ============
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=1000
RATE_LIMIT_BLOCK_MS=60000

# ============ JWT (Test) ============
JWT_SECRET="test-jwt-secret-do-not-use-in-production"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="test-refresh-secret-do-not-use-in-production"
REFRESH_TOKEN_EXPIRATION="7d"

# ============ REDIS (Test) ============
# Set to empty/null para usar in-memory storage em testes
ENABLE_REDIS=false
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# ============ CACHE (Test) ============
CACHE_TTL_HOT=10
CACHE_TTL_WARM=60
CACHE_TTL_COLD=300

# ============ EXTERNAL APIs ============
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# ============ STORAGE / EMAIL / PUSH (disabled in tests) ============
STORAGE_PROVIDER=none
LOCAL_STORAGE_ROOT=storage
BACKEND_PUBLIC_URL=http://localhost:3002
USE_CLOUDFRONT=false
ENABLE_EMAIL=false
EMAIL_PROVIDER=none
PUSH_PROVIDER=none
AWS_SNS_REGION=
AWS_SES_FROM_EMAIL=

# ============ OBSERVABILITY (Test) ============
APP_NAME=meu-agito-backend-test
LOG_LEVEL=error
AWS_CLOUDWATCH_LOG_GROUP=
AWS_CLOUDWATCH_LOG_RETENTION_DAYS=
AWS_CLOUDWATCH_NAMESPACE=
AWS_XRAY_ENABLED=false
AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000
AWS_XRAY_CONTEXT_MISSING=LOG_ERROR
AWS_XRAY_SERVICE_NAME=meu-agito-backend-test
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
