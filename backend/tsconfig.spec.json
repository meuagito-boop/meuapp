{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "module": "commonjs",
        "isolatedModules": true,
        "types": [
            "jest",
            "node",
            "express",
            "multer"
        ]
    },
    "include": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "dist"
    ]
}
