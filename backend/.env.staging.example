# Meu Agito backend - staging economico AWS
# Objetivo: validar app real com custo inicial menor antes de liberar producao.

# ============ SERVER ============
NODE_ENV=production
DEPLOY_ENV=staging
PORT=3001
TRUST_PROXY=true
ENABLE_SWAGGER=false
CORS_ORIGIN="https://staging-api.meuagito.com"
FRONTEND_URL="meuagito://"
SUPPORT_EMAIL="suporte@meuagito.com"

# ============ DATABASE / AUTH ============
DATABASE_URL="postgresql://USER:PASSWORD@RDS_STAGING_ENDPOINT:5432/meuagito_staging?schema=public"
JWT_SECRET="CHANGE_ME_STAGING_JWT_SECRET"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="CHANGE_ME_STAGING_REFRESH_SECRET"
REFRESH_TOKEN_EXPIRATION="7d"

# ============ REDIS ============
# Staging pode rodar sem Redis/Valkey para reduzir custo inicial.
ENABLE_REDIS=false
REDIS_URL=""

# ============ RATE LIMIT / CACHE ============
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
RATE_LIMIT_BLOCK_MS=60000
CACHE_TTL_HOT=60
CACHE_TTL_WARM=1800
CACHE_TTL_COLD=86400

# ============ EXTERNAL APIs ============
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# ============ STORAGE ============
STORAGE_PROVIDER="s3"
AWS_REGION="sa-east-1"
AWS_S3_BUCKET="meuagito-staging-media"
S3_REGION="sa-east-1"
S3_BUCKET="meuagito-staging-media"
# Preferir IAM role na EC2. Nao preencher chaves se a role estiver configurada.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE=false
USE_CLOUDFRONT=false
CLOUDFRONT_BASE_URL=""
AWS_CLOUDFRONT_URL=""
BACKEND_PUBLIC_URL="https://staging-api.meuagito.com"
LOCAL_STORAGE_ROOT="storage"
HEALTHCHECK_VERIFY_STORAGE=false

# ============ EMAIL ============
# Staging pode iniciar sem SES. Se EMAIL_PROVIDER=ses, validar dominio/remetente no SES.
ENABLE_EMAIL=false
EMAIL_PROVIDER="none"
AWS_SES_REGION="sa-east-1"
AWS_SES_FROM_EMAIL=""

# ============ PUSH ============
# Staging pode iniciar sem push. Ativar SNS quando for validar push real em device.
PUSH_PROVIDER="none"
AWS_SNS_REGION="sa-east-1"
AWS_SNS_DEFAULT_TOPIC_ARN=""
AWS_SNS_TOPIC_ARN_PREFIX=""
AWS_SNS_PLATFORM_APPLICATION_ARN=""
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=""
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=""

# ============ OBSERVABILITY ============
APP_NAME="meu-agito-backend"
LOG_LEVEL="info"
AWS_CLOUDWATCH_LOG_GROUP="/aws/ec2/meuagito-staging-backend"
AWS_CLOUDWATCH_LOG_RETENTION_DAYS=14
AWS_CLOUDWATCH_NAMESPACE="MeuAgito/staging"
AWS_XRAY_ENABLED=false
AWS_XRAY_DAEMON_ADDRESS="127.0.0.1:2000"
AWS_XRAY_CONTEXT_MISSING="LOG_ERROR"
AWS_XRAY_SERVICE_NAME="meu-agito-staging-backend"
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0
