# Meu Agito backend - producao AWS
# Objetivo: release publico. Nao usar localhost, mocks ou dependencias opcionais criticas.

# ============ SERVER ============
NODE_ENV=production
DEPLOY_ENV=production
PORT=3001
TRUST_PROXY=true
ENABLE_SWAGGER=false
CORS_ORIGIN="https://api.meuagito.com"
FRONTEND_URL="meuagito://"
SUPPORT_EMAIL="suporte@meuagito.com"

# ============ DATABASE / AUTH ============
DATABASE_URL="postgresql://USER:PASSWORD@RDS_PROD_ENDPOINT:5432/meuagito_prod?schema=public"
JWT_SECRET="CHANGE_ME_PROD_JWT_SECRET"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="CHANGE_ME_PROD_REFRESH_SECRET"
REFRESH_TOKEN_EXPIRATION="7d"

# ============ REDIS / VALKEY ============
# Obrigatorio em DEPLOY_ENV=production para cache, rate limit e Socket.IO distribuido.
ENABLE_REDIS=true
REDIS_URL="redis://ELASTICACHE_ENDPOINT:6379"

# ============ RATE LIMIT / CACHE ============
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
RATE_LIMIT_BLOCK_MS=60000
CACHE_TTL_HOT=60
CACHE_TTL_WARM=1800
CACHE_TTL_COLD=86400

# ============ EXTERNAL APIs ============
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# ============ STORAGE ============
STORAGE_PROVIDER="s3"
AWS_REGION="sa-east-1"
AWS_S3_BUCKET="meuagito-prod-media"
S3_REGION="sa-east-1"
S3_BUCKET="meuagito-prod-media"
# Preferir IAM role da ECS task/EC2. Chaves explicitas sao fallback operacional, nao padrao.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE=false
USE_CLOUDFRONT=true
CLOUDFRONT_BASE_URL="https://cdn.meuagito.com"
AWS_CLOUDFRONT_URL="https://cdn.meuagito.com"
BACKEND_PUBLIC_URL="https://api.meuagito.com"
LOCAL_STORAGE_ROOT="storage"
HEALTHCHECK_VERIFY_STORAGE=true

# ============ EMAIL / SES ============
ENABLE_EMAIL=true
EMAIL_PROVIDER="ses"
AWS_SES_REGION="sa-east-1"
AWS_SES_FROM_EMAIL="noreply@meuagito.com"

# ============ PUSH / SNS ============
PUSH_PROVIDER="sns"
AWS_SNS_REGION="sa-east-1"
AWS_SNS_DEFAULT_TOPIC_ARN=""
AWS_SNS_TOPIC_ARN_PREFIX=""
AWS_SNS_PLATFORM_APPLICATION_ARN=""
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID="arn:aws:sns:sa-east-1:ACCOUNT_ID:app/GCM/meuagito-android"
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=""

# ============ OBSERVABILITY ============
APP_NAME="meu-agito-backend"
LOG_LEVEL="info"
AWS_CLOUDWATCH_LOG_GROUP="/aws/ecs/meuagito-prod-backend"
AWS_CLOUDWATCH_LOG_RETENTION_DAYS=30
AWS_CLOUDWATCH_NAMESPACE="MeuAgito/prod"
AWS_XRAY_ENABLED=false
AWS_XRAY_DAEMON_ADDRESS="127.0.0.1:2000"
AWS_XRAY_CONTEXT_MISSING="LOG_ERROR"
AWS_XRAY_SERVICE_NAME="meu-agito-prod-backend"
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0
